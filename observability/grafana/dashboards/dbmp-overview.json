    {
      "id": 11,
      "title": "Waktu tunggu koneksi (per detik)",
      "type": "timeseries",
      "description": "Detik yang dihabiskan untuk mengambil koneksi per detik waktu nyata. Naik = pool kekurangan koneksi.",
      "datasource": {
        "type": "prometheus",
        "uid": "dbmp-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 8,
        "h": 8
