APP_ENV=development
LOG_LEVEL=info
HTTP_ADDRESS=:8080

PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=platform_dev_password
PLATFORM_DB_NAME=platform_db
PLATFORM_DB_PORT=55432
PLATFORM_DATABASE_URL=postgres://platform:platform_dev_password@localhost:55432/platform_db?sslmode=disable
PLATFORM_DB_MIN_CONNECTIONS=2
PLATFORM_DB_MAX_CONNECTIONS=10
PLATFORM_DB_MAX_CONNECTION_IDLE=5m
PLATFORM_DB_MAX_CONNECTION_LIFETIME=30m
PLATFORM_DB_HEALTH_TIMEOUT=5s

TARGET_DB_USER=target_owner
TARGET_DB_PASSWORD=target_dev_password
TARGET_DB_NAME=target_db
TARGET_DB_PORT=55433

